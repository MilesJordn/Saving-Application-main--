{
    "version": 2,
    "trailingSlash": false,
    "cleanUrls": true,
    "headers": [
      {
        "source": "/(.*)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-store, must-revalidate"
          }
        ]
      }
    ],
    "rewrites": [
      { "source": "/api/:path*", "destination": "http://localhost:5000/api/:path*" }
    ],
    "routes": [
      { "handle": "filesystem" },
      { "src": "/.*", "dest": "/index.html", "status": 200 }
    ]
  }